{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maze-book.local/schemas/maze-analysis.schema.json",
  "title": "Canonical maze analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mazeId", "mazeIndex", "exact", "reachable", "simplePathCount",
               "deadEndCells", "shortestRouteLength", "bestRouteLength", "bestCandyTotal",
               "secondBestCandyTotal", "uniqueHighestCandy", "bestRoute", "routeSummaries", "validation"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mazeId": { "type": "string", "minLength": 1 },
    "mazeIndex": { "type": "integer", "minimum": 1 },
    "exact": { "type": "boolean" },
    "reachable": { "type": "integer", "minimum": 0 },
    "reachableFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "loopCount": { "type": "integer", "minimum": 0 },
    "simplePathCount": { "type": "integer", "minimum": 0 },
    "deadEndCells": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
    "shortestRouteLength": { "type": "integer", "minimum": 1 },
    "bestRouteLength": { "type": "integer", "minimum": 1 },
    "bestCandyTotal": { "type": "integer", "minimum": 0 },
    "secondBestCandyTotal": { "type": "integer", "minimum": 0 },
    "uniqueHighestCandy": { "type": "boolean" },
    "bestRoute": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "minItems": 2 },
    "temptingRouteCount": { "type": "integer", "minimum": 0 },
    "routeSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routeIndex", "length", "candyTotal"],
        "properties": {
          "routeIndex": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 },
          "candyTotal": { "type": "integer", "minimum": 0 },
          "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "errors", "warnings"],
      "properties": {
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
